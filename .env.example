# ==========================================================
# GAPAGO 환경 변수 예시
#   cp .env.example .env  후 사용할 항목만 채우세요.
#   최소 요구: LLM provider 1개 + TAVILY_API_KEY
# ==========================================================

# ── 기본 LLM Provider ──────────────────────────────────────
# azure | claude | gemini | groq | exaone | qwq
LLM_PROVIDER=azure

# ── Azure OpenAI (GPT) ────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5.1-chat
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── Claude via AWS Bedrock ────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_CLAUDE_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0

# ── Groq (GAP 추론 단계) ──────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
GROQ_REASONING_EFFORT=default

# ── Google Gemini (Vertex AI) ─────────────────────────────
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# ── 로컬 GPU 모델 (선택) ──────────────────────────────────
EXAONE_MODEL_PATH=LGAI-EXAONE/EXAONE-3.5-7.8B-Instruct
QWQ_MODEL_PATH=Qwen/QwQ-32B

# ── 웹 검색 (필수) ────────────────────────────────────────
TAVILY_API_KEY=

# ── ScienceON (한국 논문/특허/보고서, 선택) ────────────────
SCIENCEON_CLIENT_ID=
SCIENCEON_MAC_ADDRESS=
SCIENCEON_KEY=
SCIENCEON_DEFAULT_ROW_COUNT=20

# ── 파이프라인 튜닝 (선택) ────────────────────────────────
ARXIV_MAX_RESULTS=20
TAVILY_MAX_RESULTS=5
FULLTEXT_TARGET_COUNT=30
BM25_TOP_K=50
RERANKER_TOP_K=15
# light(MiniLM, CPU) | full(SPECTER2+BGE) | auto
RERANK_MODELS=auto
# 1이면 LLM 오케스트레이터 동적 라우팅 모드
GAPAGO_ORCHESTRATOR=0

# ── LangSmith 트레이싱 (선택) ─────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=GAPAGO
