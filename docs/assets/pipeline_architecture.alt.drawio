        <!-- FR → End -->
        <mxCell id="e_fr_end" style="rounded=1;strokeColor=#2C3E50;strokeWidth=2;" edge="1" source="fr" target="endnode" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- FR → GCA (result context) -->
        <mxCell id="e_fr_gca" value="&lt;font style=&quot;font-size:9px;color:#CA6F1E&quot;&gt;result context&lt;/font&gt;" style="rounded=1;strokeColor=#CA6F1E;strokeWidth=1.5;dashed=1;" edge="1" source="fr" target="gca" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ============ FEEDBACK LOOPS ============ -->
        <!-- RETRY: LEV → LE -->
        <mxCell id="e_retry" value="&lt;font style=&quot;font-size:10px;color:#CB4335&quot;&gt;&lt;b&gt;RETRY&lt;/b&gt;&lt;/font&gt;" style="rounded=1;strokeColor=#CB4335;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" source="lev" target="le" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1143" y="125"/><mxPoint x="970" y="125"/></Array></mxGeometry>
        </mxCell>
        <!-- REDO_RETRIEVAL: CS → ME -->
        <mxCell id="e_redo" value="&lt;font style=&quot;font-size:10px;color:#2E86C1&quot;&gt;&lt;b&gt;REDO_RETRIEVAL&lt;/b&gt;&lt;/font&gt;" style="rounded=1;strokeColor=#2E86C1;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" source="cs" target="me" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="555" y="450"/><mxPoint x="575" y="450"/></Array></mxGeometry>
        </mxCell>
        <!-- REFINE_QUERY: CS → QA -->
        <mxCell id="e_refine" value="&lt;font style=&quot;font-size:10px;color:#D4AC0D&quot;&gt;&lt;b&gt;REFINE_QUERY&lt;/b&gt;&lt;/font&gt;" style="rounded=1;strokeColor=#D4AC0D;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" source="cs" target="qa" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="540"/><mxPoint x="250" y="420"/></Array></mxGeometry>
        </mxCell>

      </root>
