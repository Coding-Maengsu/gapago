        <mxCell id="e_lev_rc" value="&lt;font style=&quot;font-size:10px;color:#17A589&quot;&gt;&lt;b&gt;PASS&lt;/b&gt;&lt;/font&gt;" style="rounded=1;strokeColor=#17A589;strokeWidth=2;exitX=0;exitY=1;entryX=1;entryY=0;" edge="1" source="lev" target="rc" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1055" y="430"/><mxPoint x="360" y="430"/></Array></mxGeometry>
